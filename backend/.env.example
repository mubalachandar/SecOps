# =============================================================================
# SecOps AI Copilot — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
NODE_ENV=development           # development | production | test
PORT=5000                      # HTTP server port

# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL 15)
# ---------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/secops
# Connection pool — set lower for small instances (t2.micro: use 5)
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# CACHE (Redis 7)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# AI / MACHINE LEARNING (Google Gemini)
# ---------------------------------------------------------------------------
# Primary API key — used for background alert analysis (rate-limited queue)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: separate key for interactive chat to avoid rate limit conflicts
# If not set, falls back to GEMINI_API_KEY
GEMINI_CHAT_API_KEY=your_second_gemini_api_key_here
# Model name — gemini-1.5-flash is recommended (free tier available)
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_required
JWT_EXPIRES_IN=24h

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# AWS CloudTrail (Real log ingestion)
# If not configured, the app runs in simulation mode with synthetic events.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# S3 bucket where CloudTrail logs are delivered
CLOUDTRAIL_LOG_BUCKET=your-cloudtrail-bucket-name
# Optional: prefix path inside the bucket (e.g., AWSLogs/123456789/CloudTrail/)
CLOUDTRAIL_LOG_PREFIX=

# ---------------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------------
# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# RATE LIMITING
# ---------------------------------------------------------------------------
# General API rate limit (default: 100 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Auth endpoint rate limit (default: 10 requests per 15 minutes)
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# NOTIFICATIONS — Slack
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#security-alerts

# ---------------------------------------------------------------------------
# NOTIFICATIONS — Email (SendGrid)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=secops@yourdomain.com
SENDGRID_FROM_NAME=SecOps AI Copilot
# Comma-separated list of analyst email addresses to notify
NOTIFICATION_EMAIL_RECIPIENTS=analyst@company.com,admin@company.com

# ---------------------------------------------------------------------------
# NOTIFICATION TRIGGERS
# ---------------------------------------------------------------------------
NOTIFY_ON_CRITICAL=true
NOTIFY_ON_HIGH=true
NOTIFY_ON_INCIDENT=true
